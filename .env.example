# ─── Hostinger FTP ───────────────────────────────────────────
# Tu hostname FTP (lo encuentras en Hostinger > Hosting > FTP Accounts)
FTP_HOST=files.000webhost.com
FTP_PORT=21
FTP_USER=tu_usuario_ftp
FTP_PASSWORD=tu_contraseña_ftp

# Ruta en el servidor donde vive el sitio web (normalmente public_html)
FTP_REMOTE_DIR=/public_html

# ─── Seguridad de la interfaz ────────────────────────────────
# Contraseña para que solo tú (o tu cliente) pueda subir archivos
UPLOAD_PASSWORD=cambia_esta_contraseña

# Puerto en que correrá el servidor local
PORT=3000
